#!/usr/bin/env bash
# nixe: install, update and remove Nixe apps.
#
#   nixe list                   the apps, and which are installed
#   nixe install APP… | all     install apps (pass --default to open their files)
#   nixe update                 rebuild every installed app from the latest source
#   nixe uninstall APP… [--purge]
set -euo pipefail

REPO="design-nexus/nixe"
RAW="https://raw.githubusercontent.com/$REPO/main"
ALL=(settings contacts tasks torrents pdf notepad music media-player theater chat fonts archive office photos glimpse store git passwords weather news capture pulse)
bin="$HOME/.local/bin"

# The program that shows an app is installed.
program() {
  case $1 in
    office) echo nixe-office ;;
    photos) echo nixe-photos ;;
    *) echo "nixe-$1" ;;
  esac
}

installed() {
  for a in "${ALL[@]}"; do [[ -x $bin/$(program "$a") ]] && echo "$a"; done
}

run() {
  local script=$1
  shift
  curl -fsSL "$RAW/$script" | bash -s -- "$@"
}

case ${1:-} in
  list)
    for a in "${ALL[@]}"; do
      if [[ -x $bin/$(program "$a") ]]; then printf '  %-13s installed\n' "$a"; else printf '  %s\n' "$a"; fi
    done ;;
  install) shift; run install.sh "$@" ;;
  update)
    mapfile -t apps < <(installed)
    ((${#apps[@]})) || { echo "No Nixe apps are installed."; exit 0; }
    run install.sh "${apps[@]}" ;;
  uninstall | remove) shift; run uninstall.sh "$@" ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
