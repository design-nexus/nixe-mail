[Desktop Entry]
Type=Application
Name=Mail
GenericName=Email
Comment=Every mail account in one inbox
Exec=nyx-mail %u
Icon=io.github.design_nexus.nyx.Mail
Terminal=false
Categories=Network;Email;GTK;
Keywords=mail;email;inbox;imap;smtp;
MimeType=x-scheme-handler/mailto;x-scheme-handler/nyx-mail;
StartupNotify=true
StartupWMClass=io.github.design_nexus.nyx.Mail
Actions=compose;

[Desktop Action compose]
Name=New Message
Exec=nyx-mail --compose
